<?xml version="1.0" encoding="UTF-8"?>
<!-- Reporte Parcial de Caja grande y legible de 42 columnas -->
<output>
    <ticket>
        <line></line>
        <line></line>
        <line size="1"><text align="center" length="42" bold="true">REPORTE PARCIAL DE CAJA</text></line>
        <line><text bold="true">------------------------------------------</text></line>
        <line></line>
        <line><text length="16" bold="true">EJECUTADO:</text><text bold="true" length="26">${payments.printUser()}</text></line>
        <line><text length="16" bold="true">TERMINAL:</text><text bold="true" length="26">${payments.printHost()}</text></line>
        <line><text length="16" bold="true">SECUENCIA:</text><text bold="true" length="26">${payments.printSequence()}</text></line>
        <line><text length="16" bold="true">INICIO:</text><text bold="true" length="26">${payments.printDateStart()}</text></line>
        <line><text length="16" bold="true">FIN:</text><text bold="true" length="26">${payments.printDateEnd()}</text></line>
        <line></line>
        <line size="1"><text align="center" length="42" bold="true">RESUMEN PARCIAL</text></line>
        <line><text bold="true">------------------------------------------</text></line>
        <line><text align="left" length="20" bold="true">TOTAL PAGOS:</text><text align="right" length="22" bold="true">${payments.printPaymentsTotal()}</text></line>
        <line><text align="left" length="20" bold="true">VENTAS NETAS:</text><text align="right" length="22" bold="true">${payments.printSalesBase()}</text></line>
        <line><text align="left" length="20" bold="true">IMPUESTO:</text><text align="right" length="22" bold="true">${payments.printSalesTaxes()}</text></line>
        <line size="1"><text align="left" length="20" bold="true">VENTAS BRUTAS:</text><text align="right" length="22" bold="true">${payments.printSalesTotal()}</text></line>
        <line></line>
    </ticket>
</output>
