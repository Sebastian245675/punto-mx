<?xml version="1.0" encoding="UTF-8"?>
<!-- Formato de cortes grande, uniforme y legible de 30 columnas -->
<output>
    <ticket>
        #if ($isDayClose && $allShifts && !$allShifts.isEmpty())
        <line size="3"><text align="center" length="30" bold="true">CORTE DEL DIA</text></line>
        <line size="3"><text align="center" length="30" bold="true">$dayCloseDate</text></line>
        <line></line>
        <line size="3"><text align="left" length="10" bold="true">REALIZADO:</text><text align="right" length="20" bold="true">$dayClosePerformedAt</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">VENTAS TOTALES:</text><text align="right" length="12" bold="true">$totalDaySales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">GANANCIA:</text><text align="right" length="12" bold="true">$totalDayProfit</text></line>
        <line size="3"><text align="center" length="30" bold="true">$totalDayReceiptCount VENTAS EN EL DIA</text></line>

        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="center" length="30" bold="true">== VENTAS ==</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="left" length="18" bold="true">EN EFECTIVO:</text><text align="right" length="12" bold="true">$totalDayCashGross</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">CON TARJETA:</text><text align="right" length="12" bold="true">$totalDayCardSales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">A CREDITO:</text><text align="right" length="12" bold="true">$totalDayCreditSales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">CON VALES:</text><text align="right" length="12" bold="true">$totalDayVoucherSales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">TRANSFERENCIA:</text><text align="right" length="12" bold="true">$totalDayTransferSales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">CHEQUE:</text><text align="right" length="12" bold="true">$totalDayChequeSales</text></line>
        #if($showTotalDayOtherSales)
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">OTROS:</text><text align="right" length="12" bold="true">$totalDayOtherSales</text></line>
        #end
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">DEV. DE VENTAS:</text><text align="right" length="12" bold="true">- $totalDayReturns</text></line>
        <line size="3"><text align="left" length="30" bold="true">------------------------------</text></line>
        <line size="3"><text align="left" length="18" bold="true">TOTAL VENTAS:</text><text align="right" length="12" bold="true">$totalDaySales</text></line>

        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="center" length="30" bold="true">== VENTAS POR TURNO ==</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        #foreach ($shift in $allShifts)
        <line size="3"><text align="left" length="18" bold="true">${shift.printCompactLabel()}</text><text align="right" length="12" bold="true">${shift.printTotalSales()}</text></line>
        #if($foreach.hasNext)
        <line></line>
        #end
        #end
        <line size="3"><text align="left" length="30" bold="true">------------------------------</text></line>
        <line size="3"><text align="left" length="18" bold="true">TOTAL TURNOS:</text><text align="right" length="12" bold="true">$totalDaySales</text></line>

        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="center" length="30" bold="true">== VENTAS POR DEPTO ==</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        #if($dayDeptLines && !$dayDeptLines.isEmpty())
        #foreach ($dept in $dayDeptLines)
        <line size="3"><text align="left" length="18" bold="true">${dept.compactName}</text><text align="right" length="12" bold="true">${dept.sales}</text></line>
        #if($foreach.hasNext)
        <line></line>
        #end
        #end
        #else
        <line size="3"><text align="center" length="30" bold="true">SIN VENTAS POR DEPTO</text></line>
        #end
        <line size="3"><text align="left" length="30" bold="true">------------------------------</text></line>
        <line size="3"><text align="left" length="18" bold="true">TOTAL DEPTOS:</text><text align="right" length="12" bold="true">$totalDayDepartmentSales</text></line>

        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="center" length="30" bold="true">== MOVIMIENTOS CAJA ==</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="left" length="18" bold="true">ABONOS CRED.:</text><text align="right" length="12" bold="true">$totalDayCreditPay</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">ENTRADAS EFEC.:</text><text align="right" length="12" bold="true">$totalDayCashIn</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">SALIDAS EFEC.:</text><text align="right" length="12" bold="true">$totalDayCashOut</text></line>
        <line size="3"><text align="left" length="30" bold="true">------------------------------</text></line>
        <line size="3"><text align="left" length="18" bold="true">EFECTIVO ESP.:</text><text align="right" length="12" bold="true">$totalDayCashTotal</text></line>
        <line></line>
        <line></line>
        <line></line>
        <line></line>
        <line></line>
        <line></line>

        #else
        <line size="3"><text align="center" length="30" bold="true">CIERRE DE TURNO</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>

        <line size="3"><text align="left" length="8" bold="true">CAJERO:</text><text align="right" length="22" bold="true">${payments.printUser()}</text></line>
        <line></line>
        <line size="3"><text align="left" length="8" bold="true">TURNO #:</text><text align="right" length="22" bold="true">${payments.printSequence()}</text></line>
        <line></line>
        <line size="3"><text align="left" length="8" bold="true">INICIO:</text><text align="right" length="22" bold="true">${payments.printDateStart()}</text></line>
        <line></line>
        <line size="3"><text align="left" length="8" bold="true">FIN:</text><text align="right" length="22" bold="true">${payments.printDateEnd()}</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>

        <line size="3"><text align="left" length="18" bold="true">VENTAS TOTALES:</text><text align="right" length="12" bold="true">$shiftTotalSales</text></line>
        <line size="3"><text align="center" length="30" bold="true">$shiftReceiptCount VENTAS EN EL TURNO</text></line>

        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="center" length="30" bold="true">== VENTAS ==</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="left" length="18" bold="true">EN EFECTIVO:</text><text align="right" length="12" bold="true">$shiftCashGross</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">CON TARJETA:</text><text align="right" length="12" bold="true">$shiftCardSales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">A CREDITO:</text><text align="right" length="12" bold="true">$shiftCreditSales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">CON VALES:</text><text align="right" length="12" bold="true">$shiftVoucherSales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">TRANSFERENCIA:</text><text align="right" length="12" bold="true">$shiftTransferSales</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">CHEQUE:</text><text align="right" length="12" bold="true">$shiftChequeSales</text></line>
        #if($showShiftOtherSales)
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">OTROS:</text><text align="right" length="12" bold="true">$shiftOtherSales</text></line>
        #end
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">DEV. DE VENTAS:</text><text align="right" length="12" bold="true">- $shiftReturns</text></line>
        <line size="3"><text align="left" length="30" bold="true">------------------------------</text></line>
        <line size="3"><text align="left" length="18" bold="true">TOTAL VENTAS:</text><text align="right" length="12" bold="true">$shiftTotalSales</text></line>

        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="center" length="30" bold="true">== VENTAS POR DEPTO ==</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        #if($shiftDeptLines && !$shiftDeptLines.isEmpty())
        #foreach ($dept in $shiftDeptLines)
        <line size="3"><text align="left" length="18" bold="true">${dept.compactName}</text><text align="right" length="12" bold="true">${dept.sales}</text></line>
        #if($foreach.hasNext)
        <line></line>
        #end
        #end
        #else
        <line size="3"><text align="center" length="30" bold="true">SIN VENTAS POR DEPTO</text></line>
        #end
        <line size="3"><text align="left" length="30" bold="true">------------------------------</text></line>
        <line size="3"><text align="left" length="18" bold="true">TOTAL DEPTOS:</text><text align="right" length="12" bold="true">$shiftDepartmentSales</text></line>

        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="center" length="30" bold="true">== MOVIMIENTOS CAJA ==</text></line>
        <line size="3"><text align="left" length="30" bold="true">==============================</text></line>
        <line size="3"><text align="left" length="18" bold="true">FONDO INICIAL:</text><text align="right" length="12" bold="true">$shiftInitialAmount</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">VTAS EFEC. NETAS:</text><text align="right" length="12" bold="true">$shiftCashNet</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">ABONOS CRED.:</text><text align="right" length="12" bold="true">$shiftCreditPay</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">ENTRADAS EFEC.:</text><text align="right" length="12" bold="true">$shiftCashIn</text></line>
        <line></line>
        <line size="3"><text align="left" length="18" bold="true">SALIDAS EFEC.:</text><text align="right" length="12" bold="true">$shiftCashOut</text></line>
        <line size="3"><text align="left" length="30" bold="true">------------------------------</text></line>
        <line size="3"><text align="left" length="18" bold="true">EFECTIVO ESP.:</text><text align="right" length="12" bold="true">$shiftExpectedCash</text></line>
        <line></line>
        <line></line>
        <line></line>
        <line></line>
        <line></line>
        <line></line>
        #end
    </ticket>
</output>
